# ── Rendered outputs (regenerated by `quarto render`) ──
*.pdf
*.html
*.tex
*.aux
*.log
/*_files/
/_site/
/_book/
/site_libs/
.quarto/
*.quarto_ipynb*

# ── HTML that is SOURCE, not output ──
# The `*.html` rule above is for rendered pages, but it also caught the book's
# entire stylesheet and every widget: `git ls-files '*.html'` used to return zero,
# so a fresh clone rendered unstyled with nine broken iframes.
!_styles.html
!widgets/**/*.html

# ── Figures generated by the inline Python blocks on render ──
c*_fig*.png

# ── OS / editor / env cruft ──
.DS_Store
.Rhistory
.RData
.Rproj.user/
__pycache__/
.ipynb_checkpoints/
.venv/
.claude/

/.quarto/
**/*.quarto_ipynb

# Local troubleshooting
.debug
pdf-link-fix-ideas.md
chapter-split-plan.md

session_dump.jsonl